{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/startupsolellc/us-llc-fees-dataset/blob/main/filing-deadlines/schema/state.schema.json",
  "title": "Domestic LLC periodic-report deadline projection",
  "description": "A fail-closed projection for one ordinary domestic LLC periodic-report result. Franchise tax, tax filings, information filings, fees, penalties, and status consequences are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "stateName", "stateAbbr", "stateSlug", "entityScope",
    "obligationType", "acceptedUserInputs", "systemInputs", "outcome", "readiness",
    "blockerCodes", "calculation", "lineage", "lastVerified", "notes"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "stateName": { "type": "string", "minLength": 2 },
    "stateAbbr": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "stateSlug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "entityScope": { "const": "domestic_llc" },
    "obligationType": { "const": "periodic_report" },
    "acceptedUserInputs": { "const": ["state", "formation_date"] },
    "systemInputs": { "const": ["asOfDate"] },
    "outcome": { "enum": ["calculated", "not_required", "unavailable"] },
    "readiness": { "enum": ["production_ready", "blocked"] },
    "blockerCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^FD_PERIODIC_[A-Z0-9_]+$" }
    },
    "calculation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/calculation" }
      ]
    },
    "lineage": { "$ref": "#/definitions/lineage" },
    "lastVerified": { "type": "string", "format": "date" },
    "notes": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "calculated" } } },
      "then": {
        "properties": {
          "readiness": { "const": "production_ready" },
          "blockerCodes": { "maxItems": 0 },
          "calculation": { "$ref": "#/definitions/calculation" },
          "lineage": { "properties": { "officialActionRef": { "type": "string" } } }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "not_required" } } },
      "then": {
        "properties": {
          "readiness": { "const": "production_ready" },
          "blockerCodes": { "maxItems": 0 },
          "calculation": { "type": "null" },
          "lineage": { "properties": { "officialActionRef": { "type": "null" } } }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "unavailable" } } },
      "then": {
        "properties": {
          "readiness": { "const": "blocked" },
          "blockerCodes": { "minItems": 1 },
          "calculation": { "type": "null" },
          "lineage": { "properties": { "officialActionRef": { "type": "null" } } }
        }
      }
    }
  ],
  "definitions": {
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultKind", "requiredInputs", "rule"],
      "properties": {
        "resultKind": { "enum": ["exact_date", "month_window"] },
        "requiredInputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["formation_date", "asOfDate"] }
        },
        "rule": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "month", "day", "intervalYears", "yearBasis", "weekendHolidayAdjustment"],
              "properties": {
                "type": { "const": "fixed_month_day" },
                "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                "day": { "type": "integer", "minimum": 1, "maximum": 31 },
                "intervalYears": { "enum": [1, 2] },
                "yearBasis": { "enum": ["calendar", "formation_year_parity"] },
                "weekendHolidayAdjustment": { "enum": ["none", "next_business_day", "not_stated"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "intervalYears", "monthBasis", "dayBasis"],
              "properties": {
                "type": { "const": "formation_anniversary_date" },
                "intervalYears": { "enum": [1, 2] },
                "monthBasis": { "const": "formation_month" },
                "dayBasis": { "const": "formation_day" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "intervalYears", "yearBasis", "monthBasis", "windowStart", "windowEnd"],
              "properties": {
                "type": { "const": "formation_month_window" },
                "intervalYears": { "enum": [1, 2] },
                "yearBasis": { "const": "formation_year_parity" },
                "monthBasis": { "const": "formation_month" },
                "windowStart": { "const": "first_day" },
                "windowEnd": { "const": "last_day" }
              }
            }
          ]
        }
      }
    },
    "lineageRef": {
      "type": "string",
      "pattern": "^entitysearch-state-data/states/[a-z0-9-]+\\.json#/"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordRef", "factRefs", "officialActionRef", "officialSourceRefs", "verificationRef"],
      "properties": {
        "recordRef": {
          "type": "string",
          "pattern": "^entitysearch-state-data/states/[a-z0-9-]+\\.json#$"
        },
        "factRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/lineageRef" }
        },
        "officialActionRef": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/lineageRef" }]
        },
        "officialSourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/lineageRef" }
        },
        "verificationRef": { "$ref": "#/definitions/lineageRef" }
      }
    }
  }
}
